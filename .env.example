# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Medium Integration Token
# Get from: https://medium.com/me/settings → Integration tokens
MEDIUM_TOKEN=your_medium_token_here

# WordPress credentials
# WP_URL: your site URL (no trailing slash)
# WP_APP_PASSWORD: from WP Admin → Users → Profile → Application Passwords
WP_URL=https://sreejits.com
WP_USER=your_wordpress_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
